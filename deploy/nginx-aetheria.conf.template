server {
    server_name ${AETHERIA_DOMAIN};

    client_max_body_size ${MAX_UPLOAD_SIZE_MB}M;

    location / {
        proxy_pass http://${AETHERIA_BIND};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/${AETHERIA_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AETHERIA_DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = ${AETHERIA_DOMAIN}) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name ${AETHERIA_DOMAIN};
    return 404;
}
