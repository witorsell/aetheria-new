AETHERIA_SESSION_SECRET=your_64_character_base64_encoded_secret_key_here
# literal characters, not hex/base64-decoded - needs to actually be 32 random characters
AETHERIA_ENCRYPTION_KEY=your_32_character_encryption_key_here
INITIAL_USERNAME=admin
INITIAL_PASSWORD=password
ENABLE_REGISTRATION=false
# defaults to localhost-only, nginx/a domain aren't required to run this
AETHERIA_BIND=127.0.0.1:4310
# only used by deploy/generate-nginx-config.sh, ignore this if you're not using nginx
AETHERIA_DOMAIN=yourdomain.com
MAX_UPLOAD_SIZE_MB=25
AETHERIA_GENERATE_BURST=20.0
AETHERIA_GENERATE_PER_SEC=0.5
AETHERIA_IMAGE_CACHE_MAX_CAPACITY=500
AETHERIA_IMAGE_CACHE_TTL_SECS=3600
