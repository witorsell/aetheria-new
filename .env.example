AETHERIA_SESSION_SECRET=your_64_character_base64_encoded_secret_key_here
AETHERIA_ENCRYPTION_KEY=your_32_character_hex_encoded_encryption_key_here
INITIAL_USERNAME=admin
INITIAL_PASSWORD=password
ENABLE_REGISTRATION=false
